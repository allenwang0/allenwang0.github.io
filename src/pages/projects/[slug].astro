---
import Base from "../../layouts/Base.astro";
import Chart from "../../components/Chart.astro";
import Icon from "../../components/Icon.astro";
import Metric from "../../components/Metric.astro";
import { projects, repoUrl, sourceUrl, sourcesOf, type Claim, type Project } from "../../lib/data";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { caseStudy, card, excerpt } = project;
const shortSha = project.sha.slice(0, 7);
const sourceLinks = (claim: Claim) =>
  sourcesOf(claim).map((path) => ({ path, href: sourceUrl(project.repo, project.sha, path) }));
---

<Base title={`${project.title} | Allen Wang`} description={project.blurb.map((c) => c.text).join(" ")}>
  <main class="mx-auto max-w-3xl px-6 pt-16 pb-32">
    <a href="/#projects" class="inline-flex items-center gap-1 text-[13px] font-medium text-accent hover:underline">
      <Icon name="arrow-left" size={14} /> All projects
    </a>
    <h1 class="mt-6 mb-3 text-4xl font-extrabold tracking-tight text-primary md:text-5xl">{project.title}</h1>
    <p class="mb-4 text-[16px] leading-relaxed text-secondary">{project.blurb.map((c) => c.text).join(" ")}</p>
    <p class="mb-12 text-[13px] text-secondary">
      <a href={repoUrl(project.repo)} class="font-semibold text-accent hover:underline">
        {project.repo}
      </a>{" "}
      · every statement below links to the file that backs it at commit{" "}
      <a href={`${repoUrl(project.repo)}/tree/${project.sha}`} class="font-mono text-accent hover:underline">
        {shortSha}
      </a>
      .
    </p>

    <section class="glass-card mb-8 rounded-[2rem] p-7" aria-labelledby="problem">
      <h2 id="problem" class="mb-3 text-xl font-semibold text-primary">
        Problem
      </h2>
      <p class="text-[15px] leading-relaxed text-secondary">{caseStudy.problem.text}</p>
      <p class="mt-3 text-[12px] text-secondary">
        Source:{" "}
        {sourceLinks(caseStudy.problem).map((s, i) => (
          <>
            {i > 0 && ", "}
            <a href={s.href} class="font-mono text-accent hover:underline">
              {s.path}
            </a>
          </>
        ))}
      </p>
    </section>

    <section class="glass-card mb-8 rounded-[2rem] p-7" aria-labelledby="approach">
      <h2 id="approach" class="mb-3 text-xl font-semibold text-primary">
        Approach
      </h2>
      <p class="text-[15px] leading-relaxed text-secondary">{caseStudy.approach.text}</p>
      <p class="mt-3 text-[12px] text-secondary">
        Source:{" "}
        {sourceLinks(caseStudy.approach).map((s, i) => (
          <>
            {i > 0 && ", "}
            <a href={s.href} class="font-mono text-accent hover:underline">
              {s.path}
            </a>
          </>
        ))}
      </p>
      {excerpt && (
        <figure class="mt-6">
          <figcaption class="mb-2 text-[12px] text-secondary">
            <a href={excerpt.permalink} class="font-mono text-accent hover:underline">
              {excerpt.path} lines {excerpt.start} to {excerpt.end} at {shortSha}
            </a>
          </figcaption>
          <pre
            class="overflow-x-auto rounded-2xl bg-black/85 p-4 text-[12px] leading-relaxed text-gray-100"
            tabindex="0"
          ><code>{excerpt.code}</code></pre>
        </figure>
      )}
    </section>

    <section class="glass-card mb-8 rounded-[2rem] p-7" aria-labelledby="result">
      <h2 id="result" class="mb-3 text-xl font-semibold text-primary">
        Result
      </h2>
      {card ? (
        <>
          <p class="mb-4 text-[15px] font-medium text-primary">{card.takeaway}</p>
          {card.chart && <Chart chart={card.chart} caption={`${project.title}: ${card.takeaway}`} />}
          <div class="mt-5">
            <Metric card={card} />
          </div>
          <p class="mt-3 text-[12px] text-secondary">
            Data: {card.data_note} Produced at commit{" "}
            <a href={`${repoUrl(project.repo)}/tree/${card.sha}`} class="font-mono text-accent hover:underline">
              {card.sha.slice(0, 7)}
            </a>{" "}
            on {card.generated_at.slice(0, 10)}.
          </p>
        </>
      ) : (
        <p class="results-pending text-[15px] text-secondary">
          Results pending. The repo does not have a <code class="font-mono">site/card.json</code> at {shortSha} yet. See{" "}
          <a href={repoUrl(project.repo)} class="text-accent hover:underline">
            {project.repo}
          </a>
          .
        </p>
      )}
    </section>

    <section class="glass-card rounded-[2rem] p-7" aria-labelledby="limitations">
      <h2 id="limitations" class="mb-3 text-xl font-semibold text-primary">
        Limitations
      </h2>
      <ul class="flex list-disc flex-col gap-2 pl-5 text-[15px] leading-relaxed text-secondary">
        {caseStudy.limitations.map((l) => (
          <li>
            {l.text}{" "}
            <span class="text-[12px]">
              (
              {sourceLinks(l).map((s, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={s.href} class="font-mono text-accent hover:underline">
                    {s.path}
                  </a>
                </>
              ))}
              )
            </span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
